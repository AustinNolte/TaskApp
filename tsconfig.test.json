{
  "extends": "./shared/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "paths": {
      "shared": ["./shared/src/index.ts"]
    }
  },
  "include": [
    "test/**/*.ts",
    "server/src/**/*.ts",
    "shared/src/**/*.ts",
    "vitest.config.mts"
  ]
}
